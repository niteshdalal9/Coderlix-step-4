# Coderlix — local development environment template.
#
# Copy this file to `.env` and fill in real values locally. `.env` is
# git-ignored and must NEVER be committed. This file contains variable
# NAMES and non-secret development defaults only — no real credentials,
# API keys, or passwords belong in this repository, in this file or any
# other.

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------
# Postgres (Final Architecture §3, §37 — required at MVP)
# -----------------------------------------------------------------------
POSTGRES_USER=coderlix
POSTGRES_PASSWORD=coderlix_dev_only
POSTGRES_DB=coderlix_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coderlix:coderlix_dev_only@localhost:5432/coderlix_dev

# -----------------------------------------------------------------------
# Redis (Final Architecture §37 — optional at MVP, off by default;
# only needed if you start the "redis" Docker Compose profile)
# -----------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------
# Model provider authentication — variable NAMES only (Final Architecture
# §18, §19, §21: provider routing is config-driven, never hard-coded).
# Leave blank until the Provider Gateway step wires these in; set no
# values here.
# -----------------------------------------------------------------------
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# -----------------------------------------------------------------------
# Sandbox limits (Execution Manager / Docker security baseline, §26.1 —
# consumed starting with the Execution Manager step; placeholders only,
# not enforced by anything in this bootstrap).
# -----------------------------------------------------------------------
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_DISK_QUOTA_MB=1024
SANDBOX_NETWORK_EGRESS=disabled

# -----------------------------------------------------------------------
# Budget limits (Budget Manager, §23 — consumed starting with the Budget
# Manager step; placeholders only, not enforced by anything in this
# bootstrap).
# -----------------------------------------------------------------------
BUDGET_DAILY_REQUEST_CEILING_FREE_TIER=50
BUDGET_DAILY_COST_CEILING_USD=5.00
BUDGET_PER_TASK_COST_CEILING_USD=1.00
